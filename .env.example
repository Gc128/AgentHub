# AgentHub environment variables

# Runtime
APP_ENV=development
LOG_LEVEL=INFO

# Database
PERSISTENCE_BACKEND=sqlite
DATABASE_URL=sqlite:///./agenthub.db

# Workspace
WORKSPACE_ROOT=./workspaces

# Agent provider keys. Do not fill real keys in this file.
AGENT_PROVIDER=openai-compatible
AGENT_MODEL=gpt-4o-mini
AGENT_BASE_URL=https://api.openai.com/v1
AGENT_REQUEST_TIMEOUT_SECONDS=60
AGENT_RESPONSE_FORMAT=json_object
AGENT_THINKING=auto
AGENT_MAX_TOKENS=4096
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional local coding-agent CLI backends. Keep OpenAI-compatible as default
# unless you explicitly want Code Agent to run through a local CLI.
AGENT_CLI_TIMEOUT_SECONDS=180
AGENT_CLI_MAX_OUTPUT_CHARS=60000
CODEX_CLI_PATH=codex
CLAUDE_CODE_CLI_PATH=claude
CODE_AGENT_BACKEND_ID=openai-compatible

# Agent mode
USE_MOCK_AGENTS=false
AGENT_ALLOW_FALLBACKS=false
