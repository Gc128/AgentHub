# AgentHub environment variables

# Runtime
APP_ENV=development
LOG_LEVEL=INFO

# Database
PERSISTENCE_BACKEND=sqlite
DATABASE_URL=sqlite:///./agenthub.db

# Workspace
WORKSPACE_ROOT=./workspaces

# Agent provider keys. Do not fill real keys in this file.
# Real Agent calls are routed through LangChain ChatOpenAI with an OpenAI-compatible base URL.
AGENT_PROVIDER=openai-compatible
AGENT_MODEL=deepseek-v4-flash
AGENT_BASE_URL=https://api.deepseek.com
AGENT_REQUEST_TIMEOUT_SECONDS=60
AGENT_RESPONSE_FORMAT=json_object
AGENT_THINKING=disabled
AGENT_MAX_TOKENS=4096
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Agent mode
USE_MOCK_AGENTS=false
AGENT_ALLOW_FALLBACKS=false
